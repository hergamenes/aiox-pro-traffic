{
  "name": "@aiox/google-ads-agent",
  "version": "0.1.2",
  "type": "module",
  "description": "CLI agent for automating Google Ads campaign operations",
  "bin": {
    "google-ads": "./dist/bin/google-ads.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "google-ads",
    "google-ads-api",
    "campaign-automation",
    "cli"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^13.1.0",
    "google-ads-api": "^23.0.0",
    "keytar": "^7.9.0",
    "ora": "^8.2.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "yaml": "^2.8.2",
    "zod": "3.24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.4.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "5.7",
    "typescript-eslint": "^8.57.0",
    "vitest": "^3.2.4"
  }
}
